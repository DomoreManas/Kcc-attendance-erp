# -------------------- DATABASE LAYER (SQLite) --------------------
def get_connection():
    return sqlite3.connect(DB_NAME, check_same_thread=False)


def seed_logs_for_subject(cur, subject_id, attended, total):
    """Generates clean historical weekday dates matching initial attended/total counts."""
    absent = max(total - attended, 0)
    statuses = (["Present"] * attended) + (["Absent"] * absent)
    day_cursor = datetime.now().date() - timedelta(days=1)
    generated = []
    idx = 0
    while idx < len(statuses):
        if day_cursor.weekday() < 5:
            if absent > 0 and idx % max(1, total // max(absent, 1)) == 2 and statuses.count("Absent") > 0:
                st_val = "Absent"
                statuses.remove("Absent")
            else:
                st_val = statuses.pop(0)
            generated.append((subject_id, day_cursor.strftime("%Y-%m-%d"), st_val))
        day_cursor -= timedelta(days=1)
    cur.executemany(
        "INSERT INTO attendance_logs (subject_id, log_date, status) VALUES (?, ?, ?)",
        generated
    )


def init_db():
    conn = get_connection()
    cur = conn.cursor()

    cur.execute("""
        CREATE TABLE IF NOT EXISTS subjects (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            code TEXT UNIQUE NOT NULL,
            name TEXT NOT NULL,
            credits REAL NOT NULL,
            attended INTEGER NOT NULL,
            total INTEGER NOT NULL,
            grade TEXT NOT NULL
        )
    """)

    cur.execute("""
        CREATE TABLE IF NOT EXISTS attendance_logs (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            subject_id INTEGER NOT NULL,
            log_date TEXT NOT NULL,
            status TEXT NOT NULL,
            FOREIGN KEY (subject_id) REFERENCES subjects(id) ON DELETE CASCADE
        )
    """)

    cur.execute("""
        CREATE TABLE IF NOT EXISTS student_profile (
            id INTEGER PRIMARY KEY CHECK (id = 1),
            name TEXT NOT NULL,
            roll_no TEXT NOT NULL,
            branch TEXT NOT NULL,
            section TEXT NOT NULL,
            semester TEXT NOT NULL,
            avatar_mode TEXT NOT NULL,
            doodle_name TEXT NOT NULL,
            photo_blob BLOB
        )
    """)
    conn.commit()

    cur.execute("SELECT COUNT(*) FROM student_profile")
    if cur.fetchone()[0] == 0:
        cur.execute("""
            INSERT INTO student_profile (id, name, roll_no, branch, section, semester, avatar_mode, doodle_name, photo_blob)
            VALUES (1, ?, ?, ?, ?, ?, ?, ?, ?)
        """, (
            "Manas Srivastav",
            "2504920100346",
            "B.Tech CSE",
            "Section B-3",
            "3rd Semester",
            "Pre-built Doodle",
            "🐱 Cyber Cat (Cool Shades)",
            None
        ))
        conn.commit()

    cur.execute("SELECT COUNT(*) FROM subjects")
    if cur.fetchone()[0] == 0:
        sample_subjects = [
            ("BCS301", "Data Structures", 4.0, 26, 30, "A (80-89)"),
            ("BCS302", "Computer Organization & Architecture", 4.0, 21, 30, "B+ (70-79)"),
            ("BCS303", "Discrete Structures & Theory of Logic", 4.0, 24, 28, "A+ (90-100)"),
            ("BAS303", "Mathematics-IV", 4.0, 19, 28, "B (60-69)"),
            ("BCC302", "Python Programming", 2.0, 18, 20, "A+ (90-100)"),
            ("BCS351", "Data Structures Lab", 1.0, 11, 12, "A (80-89)"),
            ("BCS352", "COA Lab", 1.0, 9, 12, "B+ (70-79)"),
        ]
        for code, name, credits, att, tot, grade in sample_subjects:
            cur.execute(
                "INSERT INTO subjects (code, name, credits, attended, total, grade) VALUES (?, ?, ?, ?, ?, ?)",
                (code, name, credits, att, tot, grade),
            )
            seed_logs_for_subject(cur, cur.lastrowid, att, tot)
        conn.commit()
    else:
        cur.execute("SELECT id, attended, total FROM subjects")
        for sub_id, att, tot in cur.fetchall():
            cur.execute("SELECT COUNT(*) FROM attendance_logs WHERE subject_id = ?", (sub_id,))
            if cur.fetchone()[0] == 0 and tot > 0:
                seed_logs_for_subject(cur, sub_id, att, tot)
        conn.commit()

    conn.close()


def fetch_profile():
    conn = get_connection()
    cur = conn.cursor()
    cur.execute("SELECT name, roll_no, branch, section, semester, avatar_mode, doodle_name, photo_blob FROM student_profile WHERE id = 1")
    row = cur.fetchone()
    conn.close()
    return {
        "name": row[0],
        "roll_no": row[1],
        "branch": row[2],
        "section": row[3],
        "semester": row[4],
        "avatar_mode": row[5],
        "doodle_name": row[6],
        "photo_blob": row[7],
    }


