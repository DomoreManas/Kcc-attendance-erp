def fetch_subject_logs(subject_id):
    conn = get_connection()
    cur = conn.cursor()
    cur.execute(
        "SELECT log_date, status FROM attendance_logs WHERE subject_id = ? ORDER BY log_date ASC, id ASC",
        (subject_id,)
    )
    rows = cur.fetchall()
    conn.close()
    return rows


def log_attendance_event(subject_id, attended, total, status, custom_date=None):
    conn = get_connection()
    cur = conn.cursor()
    cur.execute("UPDATE subjects SET attended = ?, total = ? WHERE id = ?", (attended, total, subject_id))
    date_str = custom_date.strftime("%Y-%m-%d") if custom_date else datetime.now().strftime("%Y-%m-%d")
    cur.execute(
        "INSERT INTO attendance_logs (subject_id, log_date, status) VALUES (?, ?, ?)",
        (subject_id, date_str, status)
    )
    conn.commit()
    conn.close()


def update_grade(subject_id, grade):
    conn = get_connection()
    cur = conn.cursor()
    cur.execute("UPDATE subjects SET grade = ? WHERE id = ?", (grade, subject_id))
    conn.commit()
    conn.close()


def add_subject(code, name, credits, attended, total, grade):
    conn = get_connection()
    cur = conn.cursor()
    cur.execute(
        "INSERT INTO subjects (code, name, credits, attended, total, grade) VALUES (?, ?, ?, ?, ?, ?)",
        (code.upper().strip(), name.strip(), credits, attended, total, grade),
    )
    new_sub_id = cur.lastrowid
    if total > 0:
        seed_logs_for_subject(cur, new_sub_id, attended, total)
    conn.commit()
    conn.close()


def delete_subject(subject_id):
    conn = get_connection()
    cur = conn.cursor()
    cur.execute("DELETE FROM attendance_logs WHERE subject_id = ?", (subject_id,))
    cur.execute("DELETE FROM subjects WHERE id = ?", (subject_id,))
    conn.commit()
